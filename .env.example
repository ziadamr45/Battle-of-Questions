# ══════════════════════════════════════════════════════════════════════════════
# Environment Variables - Battle of Questions
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database (PostgreSQL - Neon) ────────────────────────────────────────────
# Get your database URL from https://neon.tech/
# Use the pooler URL for DATABASE_URL and the direct URL for DIRECT_URL
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Optional: Override DATABASE_URL in sandbox environments
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ─── Next.js ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GAME_SERVICE_URL=

# ─── LiveKit Voice Chat ──────────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# ─── OpenRouter AI ───────────────────────────────────────────────────────────
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ─── Game Service ────────────────────────────────────────────────────────────
NEXT_APP_URL=http://localhost:3000
