generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tracks each reading passage/text that has been generated
model Passage {
  id         String   @id @default(cuid())
  title      String
  text       String
  gameType   String   // "قراءة متحررة" or "نصوص"
  difficulty String   // "سهل" or "متوسط" or "صعب"
  topic      String?  // Main topic/category for variety tracking
  source     String?
  createdAt  DateTime @default(now())

  // Relations
  seenBy     SeenPassage[]
}

// Tracks which users have seen which passages
model SeenPassage {
  id         String   @id @default(cuid())
  playerName String   // User identifier (since we don't have auth)
  passageId  String
  roomCode   String?  // Optional: which room they saw it in
  seenAt     DateTime @default(now())

  passage    Passage  @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@unique([playerName, passageId]) // Each player can only see a passage once
}

// Lightweight persistent guest identity — no auth, just a profile
model Guest {
  id          String   @id @default(uuid())
  displayName String
  avatarColor String   @default("#DC2626")  // Default red
  createdAt   DateTime @default(now())
  lastSeen    DateTime @updatedAt
}

// ─── Battle History System ───────────────────────────────────────────────────

// A completed battle/match record
model Battle {
  id              String   @id @default(cuid())
  roomCode        String
  gameType        String   // "قراءة متحررة" | "نصوص"
  difficulty      String   // "سهل" | "متوسط" | "صعب"
  roomType        String   // "عامة" | "خاصة"
  passageType     String?  // "علمي" | "أدبي" | "عشوائي" — only for قراءة متحررة
  totalRounds     Int
  completedRounds Int
  totalDuration   Int      // seconds — total battle duration
  hostName        String
  wasEarlyEnd     Boolean  @default(false)
  startedAt       DateTime
  endedAt         DateTime @default(now())

  participants    BattleParticipant[]
  rounds          BattleRound[]
}

// Each player's summary in a battle
model BattleParticipant {
  id            String   @id @default(cuid())
  battleId      String
  playerName    String
  guestId       String?  // Links to Guest.id for name-independent lookups
  finalRank     Int      // 1st, 2nd, 3rd...
  totalScore    Float
  roundWins     Int
  isHost        Boolean  @default(false)
  answerReview  Json?    // Full answer review: [{roundNumber, questionIndex, question, options, playerAnswer, correctAnswer, isCorrect, timeTaken, explanation}]

  battle        Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, playerName])
  @@index([guestId]) // Fast lookup by guest identity
}

// Each round's summary in a battle
model BattleRound {
  id            String   @id @default(cuid())
  battleId      String
  roundNumber   Int
  title         String   // Passage/text title for this round
  source        String?  // Source of the passage
  winnerName    String?  // Player name of round winner
  duration      Int      // seconds — round duration
  questions     Json     // [{text, options, correctAnswer, explanation}]
  roundScores   Json     // [{playerName, score, correctAnswers, totalQuestions}]

  battle        Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)

  @@unique([battleId, roundNumber])
}
