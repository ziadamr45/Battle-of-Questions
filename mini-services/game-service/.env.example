# Game Service Environment Variables
# Copy this to .env and fill in the values

# Required: NVIDIA API Key (Primary provider - DeepSeek-V4-Flash)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: NVIDIA Model (default: deepseek-ai/deepseek-v4-flash)
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash

# Optional: OpenRouter API Key (Fallback ONLY - used when NVIDIA fails completely)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter Model (default: google/gemini-2.0-flash-001)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: Frontend URL for CORS
NEXT_APP_URL=https://ma3raka.vercel.app

# Optional: Self-ping URL for keep-alive
# SELF_PING_URL=https://your-service.onrender.com

# Optional: Port (default: 3001)
# PORT=3001
